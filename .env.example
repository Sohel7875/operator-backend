# ── This operator ──────────────────────────────────────
PORT=5000
OPERATOR_ID=demo-operator
OPERATOR_NAME=Demo Operator
# Public URL the AGGREGATOR will call for wallet ops (bet/win/balance/rollback)
OPERATOR_PUBLIC_URL=http://localhost:5000

# ── Mongo ──────────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017/slot-operator-backend

# ── Player auth (JWT) ──────────────────────────────────
JWT_SECRET=operator-dev-jwt-secret-change-me
JWT_EXPIRES_IN=7d
SIGNUP_BONUS=0

# ── Shared credentials (operator already onboarded) ────
OPERATOR_API_KEY=opk_demo_operator_key_001
OPERATOR_INBOUND_SECRET=ins_demo_operator_inbound_secret_001
OPERATOR_OUTBOUND_SECRET=outs_demo_operator_outbound_secret_001

# ── Aggregator ─────────────────────────────────────────
AGGREGATOR_REST_URL=http://localhost:4000
AGGREGATOR_ADMIN_KEY=change-me-admin-key
ENABLED_GAMES=duck_hunt_96,celestial_guardians_96,super_ace_96,angliam_bayan_96,crazy_emoji_96

# ── Wallet ─────────────────────────────────────────────
CURRENCY=USD
